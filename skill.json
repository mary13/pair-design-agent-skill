  "roles": {
    "gen": {
      "name": "Generator",
      "typically": "AI",
      "responsibilities": [
        "Propose options and alternatives",
        "Generate artifacts one at a time",
        "Explain design rationale",
        "Present design choices",
        "Ask before major decisions"
      ],
      "keyAgreement": "Never dump multiple screens at once"
    },
    "synth": {
      "name": "Synthesizer",
      "typically": "Human",
      "responsibilities": [
        "Frame the problem clearly",
        "Evaluate presented options",
        "Make final decisions",
        "Provide specific feedback",
        "Keep project on track"
      ],
      "keyAgreement": "Make decisions when options are presented"
    }
  },
  "coreAgreements": {
    "goldenRule": "Never dump multiple screens/artifacts at once",
    "gen": [
      "Work one step at a time",
      "Show work as you go",
      "Never dump multiple screens",
      "Ask before major decisions",
      "Swap roles when needed"
    ],
    "synth": [
      "Frame the problem clearly",
      "Give feedback on each step",
      "Make decisions when options presented",
      "Keep us on track"
    ],
    "shared": [
      "Progressive disclosure",
      "User-centered design",
      "Iterate based on feedback",
      "Document as we build"
    ]
  },
  "redFlags": {
    "description": "Stop immediately if these occur",
    "flags": [
      {
        "flag": "Multiple screens dumped at once",
        "severity": "critical",
        "action": "Show only first screen, review one at a time"
      },
      {
        "flag": "Major architectural change without discussion",
        "severity": "critical",
        "action": "Present options with trade-offs, get approval"
      },
      {
        "flag": "Work proceeding without feedback",
        "severity": "high",
        "action": "Pause, present work, wait for direction"
      },
      {
        "flag": "Requirements assumed instead of confirmed",
        "severity": "high",
        "action": "Ask clarifying questions first"
      },
      {
        "flag": "Scope creeping beyond agreed focus",
        "severity": "medium",
        "action": "Note for later, stay focused on current step"
      }
    ]
  },
  "workflow": {
    "phases": [
      {
        "phase": 1,
        "name": "Frame",
