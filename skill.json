        "description": "Refine based on feedback"
      },
      {
        "phase": 5,
        "name": "Document",
        "lead": "Gen",
        "description": "Capture decisions and rationale"
      },
      {
        "phase": 6,
        "name": "Next",
        "lead": "Collaborative",
        "description": "Move to next artifact"
      }
    ],
    "loopCondition": "Repeat until objective met"
  },
